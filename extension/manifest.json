{
  "manifest_version": 3,
  "name": "STUST Flipclass Assistant",
  "version": "2.0.0",
  "description": "FlipClass 作業總覽：列出所有課程的作業，標示已繳交 / 未繳（進行中）/ 未繳（已過期）",
  "homepage_url": "https://github.com/Creeperlol/STUST-Flipclass-Assistant",
  "content_scripts": [
    {
      "matches": ["https://flipclass.stust.edu.tw/*"],
      "js": ["flipclass-assistant.user.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "stust-flipclass-assistant@creeperlol" }
  }
}
